{
    "info": {
      "name": "Complete Landing Page APIs - Shellafood",
      "_postman_id": "shellafood-landing-apis-2024",
      "description": "Complete API collection for all landing page registration forms and customer authentication. Includes: Customer Login/Signup, Partner, Worker, Driver, and Investor registration.",
      "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
      {
        "key": "base_url",
        "value": "https://shellafood.com",
        "type": "string"
      },
      {
        "key": "lang",
        "value": "ar",
        "type": "string"
      },
      {
        "key": "phone",
        "value": "966501234567",
        "type": "string"
      },
      {
        "key": "email",
        "value": "test@example.com",
        "type": "string"
      },
      {
        "key": "national_id",
        "value": "1234567890",
        "type": "string"
      }
    ],
    "item": [
      {
        "name": "Customer Authentication",
        "item": [
          {
            "name": "Customer Sign Up",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "if (pm.response.code === 200) {",
                    "    var jsonData = pm.response.json();",
                    "    if (jsonData.token) {",
                    "        pm.collectionVariables.set('customer_token', jsonData.token);",
                    "        console.log('✅ Customer token saved');",
                    "    }",
                    "    pm.test('Registration successful', function () {",
                    "        pm.expect(jsonData).to.have.property('token');",
                    "    });",
                    "}"
                  ],
                  "type": "text/javascript"
                }
              }
            ],
            "request": {
              "method": "POST",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json",
                  "type": "text"
                },
                {
                  "key": "X-LANG",
                  "value": "{{lang}}",
                  "type": "text"
                },
                {
                  "key": "Accept",
                  "value": "application/json",
                  "type": "text"
                }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n  \"name\": \"محمد أحمد\",\n  \"phone\": \"{{phone}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"password123\",\n  \"ref_code\": \"\"\n}",
                "options": {
                  "raw": {
                    "language": "json"
                  }
                }
              },
              "url": {
                "raw": "{{base_url}}/api/v1/auth/sign-up",
                "host": ["{{base_url}}"],
                "path": ["api", "v1", "auth", "sign-up"]
              },
              "description": "Customer registration endpoint.\n\n**Required Fields:**\n- name: Full name (will be split into f_name and l_name)\n- phone: Phone number (unique)\n- password: Minimum 8 characters\n- email: Email address (optional, unique if provided)\n- ref_code: Referral code (optional)\n\n**Response:**\n- token: Access token for authenticated requests\n- is_phone_verified: 0 or 1\n- is_email_verified: 0 or 1\n- is_personal_info: 1 if name provided\n- login_type: 'manual'\n\n**Note:** Phone verification OTP will be sent if phone verification is enabled."
            },
            "response": []
          },
          {
            "name": "Customer Login (Manual)",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "if (pm.response.code === 200) {",
                    "    var jsonData = pm.response.json();",
                    "    if (jsonData.token) {",
                    "        pm.collectionVariables.set('customer_token', jsonData.token);",
                    "        console.log('✅ Login token saved');",
                    "    }",
                    "    pm.test('Login successful', function () {",
                    "        pm.expect(jsonData).to.have.property('token');",
                    "    });",
                    "}"
                  ],
                  "type": "text/javascript"
                }
              }
            ],
            "request": {
              "method": "POST",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json",
                  "type": "text"
                },
                {
                  "key": "X-LANG",
                  "value": "{{lang}}",
                  "type": "text"
                },
                {
                  "key": "Accept",
                  "value": "application/json",
                  "type": "text"
                }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n  \"login_type\": \"manual\",\n  \"email_or_phone\": \"{{phone}}\",\n  \"password\": \"password123\",\n  \"field_type\": \"phone\",\n  \"guest_id\": \"\"\n}",
                "options": {
                  "raw": {
                    "language": "json"
                  }
                }
              },
              "url": {
                "raw": "{{base_url}}/api/v1/auth/login",
                "host": ["{{base_url}}"],
                "path": ["api", "v1", "auth", "login"]
              },
              "description": "Customer login with email/phone and password.\n\n**Required Fields:**\n- login_type: 'manual' (or 'otp' or 'social')\n- email_or_phone: Phone number or email\n- password: User password\n- field_type: 'phone' or 'email'\n- guest_id: Optional guest ID for cart transfer\n\n**Response:**\n- token: Access token\n- is_phone_verified: 0 or 1\n- is_email_verified: 0 or 1\n- is_personal_info: 0 or 1\n- login_type: 'manual'"
            },
            "response": []
          },
          {
            "name": "Customer Login (OTP - Send OTP)",
            "request": {
              "method": "POST",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json",
                  "type": "text"
                },
                {
                  "key": "X-LANG",
                  "value": "{{lang}}",
                  "type": "text"
                }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n  \"login_type\": \"otp\",\n  \"phone\": \"{{phone}}\",\n  \"verified\": false\n}",
                "options": {
                  "raw": {
                    "language": "json"
                  }
                }
              },
              "url": {
                "raw": "{{base_url}}/api/v1/auth/login",
                "host": ["{{base_url}}"],
                "path": ["api", "v1", "auth", "login"]
              },
              "description": "Send OTP to phone for login.\n\n**Required Fields:**\n- login_type: 'otp'\n- phone: Phone number\n- verified: false (to send OTP)\n\n**Response:**\n- message: OTP sent message\n\n**Next Step:** Use 'Customer Login (OTP - Verify)' with the OTP code received."
            },
            "response": []
          },
          {
            "name": "Customer Login (OTP - Verify)",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "if (pm.response.code === 200) {",
                    "    var jsonData = pm.response.json();",
                    "    if (jsonData.token) {",
                    "        pm.collectionVariables.set('customer_token', jsonData.token);",
                    "    }",
                    "}"
                  ],
                  "type": "text/javascript"
                }
              }
            ],
            "request": {
              "method": "POST",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json",
                  "type": "text"
                },
                {
                  "key": "X-LANG",
                  "value": "{{lang}}",
                  "type": "text"
                }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n  \"login_type\": \"otp\",\n  \"phone\": \"{{phone}}\",\n  \"verified\": true,\n  \"otp\": \"123456\",\n  \"guest_id\": \"\"\n}",
                "options": {
                  "raw": {
                    "language": "json"
                  }
                }
              },
              "url": {
                "raw": "{{base_url}}/api/v1/auth/login",
                "host": ["{{base_url}}"],
                "path": ["api", "v1", "auth", "login"]
              },
              "description": "Verify OTP and complete login.\n\n**Required Fields:**\n- login_type: 'otp'\n- phone: Phone number\n- verified: true\n- otp: OTP code received via SMS\n- guest_id: Optional\n\n**Response:**\n- token: Access token\n- is_phone_verified: 1\n- login_type: 'otp'\n\n**Note:** In test mode, OTP is always '123456'"
            },
            "response": []
          },
          {
            "name": "Verify Phone",
            "request": {
              "method": "POST",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json",
                  "type": "text"
                },
                {
                  "key": "X-LANG",
                  "value": "{{lang}}",
                  "type": "text"
                }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"otp\": \"123456\"\n}",
                "options": {
                  "raw": {
                    "language": "json"
                  }
                }
              },
              "url": {
                "raw": "{{base_url}}/api/v1/auth/verify-phone",
                "host": ["{{base_url}}"],
                "path": ["api", "v1", "auth", "verify-phone"]
              },
              "description": "Verify phone number with OTP.\n\n**Required Fields:**\n- phone: Phone number (11-14 digits)\n- otp: OTP code\n\n**Response:**\n- message: Verification success message\n- otp: 'inactive' after verification"
            },
            "response": []
          }
        ]
      },
