    {
      "name": "03 — Auth Flow",
      "item": [
        {
          "name": "1. Guest Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{backend_url}}/api/v1/auth/guest/request",
              "host": [
                "{{backend_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "guest",
                "request"
              ]
            },
            "description": "Step 1 (optional) — create guest session."
          },
          "response": []
        },
        {
          "name": "2. Send OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{backend_url}}/api/v2/auth/send-otp",
              "host": [
                "{{backend_url}}"
              ],
              "path": [
                "api",
                "v2",
                "auth",
                "send-otp"
              ]
            },
            "description": "Step 2 — send OTP to phone."
          },
          "response": []
        },
        {
          "name": "3. Verify OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let responseJson;",
                  "",
                  "pm.test('Response is valid JSON', function () {",
                  "    responseJson = pm.response.json();",
                  "    pm.expect(responseJson).to.be.an('object');",
                  "});",
                  "",
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "    pm.test('Successful response contains token or registration_token', function () {",
                  "        pm.expect(responseJson).to.be.an('object');",
                  "        pm.expect(responseJson.token || responseJson.registration_token).to.exist;",
                  "    });",
                  "",
                  "    if (responseJson && responseJson.token) {",
                  "        pm.collectionVariables.set('token', responseJson.token);",
                  "    }",
                  "",
                  "    if (responseJson && responseJson.registration_token) {",
                  "        pm.collectionVariables.set('registration_token', responseJson.registration_token);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"otp\": \"{{otp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{backend_url}}/api/v2/auth/verify-otp",
              "host": [
                "{{backend_url}}"
              ],
              "path": [
                "api",
                "v2",
                "auth",
                "verify-otp"
              ]
            },
            "description": "Step 3 — verify OTP and get token."
          },
          "response": []
        },
        {
          "name": "4. Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"phone\": \"{{phone}}\",\n  \"registration_token\": \"{{registration_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{backend_url}}/api/v2/auth/register",
              "host": [
                "{{backend_url}}"
              ],
              "path": [
                "api",
                "v2",
                "auth",
                "register"
              ]
            },
            "description": "Step 4 — register new user (skip if existing user got token in step 3)."
          },
          "response": []
        }
      ],
      "description": "1. **Guest Request** — optional anonymous session\n    \n2. **Send OTP** — sends code to `{{phone}}`\n    \n3. **Verify OTP** — returns token or `registration_token` for new users\n    \n4. **Register** — completes sign-up for new users"
    }
